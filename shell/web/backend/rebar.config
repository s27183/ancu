{erl_opts, [debug_info]}.

%% Same dep floor as the engine (engine/erlang/rebar.config): pgo is the mandated
%% Postgres client, cowboy is the shell's HTTP gateway. JSON = OTP 27+ built-in
%% `json`; user JWT (HS256) + tenant JWT (ed25519) both via built-in `crypto`
%% — no jsx/jose/gproc deps. The shell mirrors the engine's no-extra-deps posture.
{deps, [
    {pgo, "~> 0.15"},
    {cowboy, "~> 2.12"}
]}.

{shell, [
    {apps, [fh_shell]}
]}.

{relx, [
    {release, {fh_shell, "0.1.0"}, [
        fh_shell,
        sasl
    ]},
    {dev_mode, false},
    {include_erts, true},
    {include_src, false},
    {extended_start_script, true}
]}.

{profiles, [
    {dev,  [{relx, [{dev_mode, true},  {include_erts, false}]}]},
    {prod, [{relx, [{dev_mode, false}, {include_erts, true}, {include_src, false}]}]}
]}.
