# Engine runtime config. Copy to engine/.env (gitignored) and adjust.
# fh_engine_app loads engine/.env at boot (OS env vars take precedence).

# Postgres connection for the engine's runtime state (engine-contract §9.1).
# Matches engine/compose.yaml. sslmode=disable for local Docker.
ENGINE_DATABASE_URL=postgres://engine:engine_dev_pw@localhost:5433/firsthomey_engine?sslmode=disable
