{erl_opts, [debug_info]}.

%% pgo is the mandated Postgres client (CLAUDE.md "PostgreSQL via PGO").
%% cowboy is the /api/engine/* HTTP/SSE gateway (Wedge-1a #8 slice 1).
%% JSON = OTP 27+ built-in `json`; pub/sub = built-in `pg`; JWT = built-in `crypto`
%% (ed25519) — no jsx/jose/gproc deps.
{deps, [
    {pgo, "~> 0.15"},
    {cowboy, "~> 2.12"}
]}.

{shell, [
    {apps, [fh_engine]}
]}.

{relx, [
    {release, {fh_engine, "0.1.0"}, [
        fh_engine,
        sasl
    ]},
    {dev_mode, false},
    {include_erts, true},
    {include_src, false},
    {extended_start_script, true}
]}.

{profiles, [
    {dev,  [{relx, [{dev_mode, true},  {include_erts, false}]}]},
    {prod, [{relx, [{dev_mode, false}, {include_erts, true}, {include_src, false}]}]}
]}.
