# FirstHomey — single repo-root .env (both backends read THIS file; the aleap/atp
# convention). Copy to `.env` and fill. `.env` is gitignored; this template is not.
# OS env vars override anything set here. See docs/local-dev.md.

# --- Databases ---------------------------------------------------------------
# Shell (identity/commerce) — homebrew Postgres on :5432.
SHELL_DATABASE_URL=postgres://son@localhost:5432/firsthomey_shell?sslmode=disable
# Engine (runtime state) — docker Postgres on :5433 (engine/compose.yaml).
ENGINE_DATABASE_URL=postgres://engine:engine_dev_pw@localhost:5433/firsthomey_engine?sslmode=disable

# --- Shell identity ----------------------------------------------------------
SHELL_JWT_SECRET=dev-only-shell-jwt-secret-change-me   # HS256 user-session signing key
APP_BASE_URL=http://localhost:5173                     # where the browser reaches the app

# --- Dev tenant handshake (shell↔engine auto-mint) ---------------------------
# Shell mints + registers its ed25519 tenant key at boot; engine opens the dev-only
# registration endpoint. Leave SHELL_TENANT_ID / SHELL_TENANT_PRIVKEY UNSET to use it.
SHELL_DEV_AUTOPROVISION=1
ENGINE_DEV_PROVISION=1
# SHELL_TENANT_ID=<uuid>
# SHELL_TENANT_PRIVKEY=<base64 ed25519 priv>

# --- Login backends ----------------------------------------------------------
# Magic link: with AUTH_DEV_EXPOSE_LINK the link is returned in the JSON + shown in
# the UI (no inbox). With RESEND_API_KEY set it also emails via Resend.
AUTH_DEV_EXPOSE_LINK=1  /Users/son/Desktop/css.png
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=no-reply@yourdomain.com          # must be a Resend-verified sender
# EMAIL_FROM_NAME=FirstHomey                  # optional → "FirstHomey <no-reply@…>"
# Google OAuth (redirect URI = APP_BASE_URL + /api/auth/google/callback):
# GOOGLE_CLIENT_ID=<...>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<...>
