.idea/
.vscode/
.junie/
.claude/
**/CLAUDE.local.md

# OS detritus
.DS_Store
**/.DS_Store
Thumbs.db

# Secrets and env
.env
.env.*
!.env.example
*.pem
*.key
*.jwk
.dev-tenant.jwk

# Logs
**/logs/
*.log

# Scratch
**/scratch.md
**/scratch/
**/.scratch/

# Orchestrator subagent worktrees (Phase 2.7.4)
tmp/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# Erlang / OTP
_build/
*.beam
ebin/
erl_crash.dump
.rebar3/
rebar3.crashdump

# Compiled KB/blueprint artifact — a rebuildable projection of docs/ (git is SOT,
# emitted at deploy by engine/build/kb_compiler.py). Not tracked.
engine/erlang/priv/kb/artifact.json

# Node / SvelteKit
node_modules/
.svelte-kit/
.vite/
.cache/
.turbo/
build/

# Database
*.dump
*.sqlite
*.sqlite3

# Generated reports (local-only)
docs/reports/
docs/scratch/

# The bare `build/` patterns above (Python / Node build OUTPUT) over-match
# engine/build/ — which is build-TIME SOURCE (the KB artifact compiler), not
# output. Re-include it (its own __pycache__ etc. stay ignored by their rules).
!engine/build/
!engine/build/**/*.py
